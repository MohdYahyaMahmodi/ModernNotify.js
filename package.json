{
  "name": "modernnotify",
  "version": "1.1.0",
  "description": "A dependency-free notification library for the web. Toasts, alerts, themes, progress bars, action buttons, grouping, RTL, and TypeScript types.",
  "main": "dist/modernnotify.js",
  "module": "dist/modernnotify.esm.js",
  "browser": "dist/modernnotify.min.js",
  "types": "dist/modernnotify.d.ts",
  "exports": {
    ".": {
      "types": "./dist/modernnotify.d.ts",
      "import": "./dist/modernnotify.esm.js",
      "require": "./dist/modernnotify.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly && npm run copy-dts",
    "copy-dts": "copyfiles -f src/modernnotify.d.ts dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "notification",
    "notifications",
    "toast",
    "toast-notification",
    "alert",
    "snackbar",
    "popup",
    "message",
    "javascript",
    "typescript",
    "frontend",
    "ui",
    "dependency-free",
    "vanilla-js",
    "rtl",
    "accessible",
    "a11y"
  ],
  "author": "Mohd Mahmodi <mohd@mahmodi.com> (https://mohdmahmodi.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohdmahmodi/ModernNotify.js.git"
  },
  "bugs": {
    "url": "https://github.com/mohdmahmodi/ModernNotify.js/issues"
  },
  "homepage": "https://mohdmahmodi.com",
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "copyfiles": "^2.4.1",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  }
}
